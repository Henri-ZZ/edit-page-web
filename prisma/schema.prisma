generator client {
  provider = "prisma-client-js"
  // Vercel serverless functions run on Amazon Linux. Without this the generated
  // client only carries the build machine's engine (e.g. darwin-arm64 when built
  // on a Mac), and every query at runtime fails with "could not locate the Query
  // Engine for runtime rhel-openssl-3.0.x" — which surfaces as a blanket
  // database_error. See https://pris.ly/d/deployment
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Installation {
  id                  Int                @id @default(autoincrement())
  installationId      String             @unique @db.Uuid
  firstSeenAt         DateTime           @default(now()) @db.Timestamptz(3)
  lastSeenAt          DateTime           @default(now()) @db.Timestamptz(3)
  // Set once, when the browser opened the post-uninstall URL (§6). Best-effort:
  // null means "no uninstall observed", which also covers a lost signal, a
  // disabled extension, and offline delivery failure — it is never proof that
  // the extension is still installed.
  uninstalledAt       DateTime?          @db.Timestamptz(3)
  firstVersion        String             @db.VarChar(32)
  currentVersion      String             @db.VarChar(32)
  browser             String             @db.VarChar(32)
  browserMajorVersion Int?
  os                  String             @db.VarChar(16)
  locale              String             @db.VarChar(35)
  distribution        String             @db.VarChar(32)
  licenseType         String             @db.VarChar(16)
  settings            Json               @default("{}") @db.JsonB
  optionalPermissions Json               @default("{}") @db.JsonB
  usageDaily          UsageDaily[]
  telemetryRequests   TelemetryRequest[]

  @@index([lastSeenAt])
  @@index([currentVersion])
  @@index([licenseType])
}

model UsageDaily {
  id             Int          @id @default(autoincrement())
  installationId String       @db.Uuid
  date           DateTime     @db.Date
  events         Json         @default("{}") @db.JsonB
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  installation   Installation @relation(fields: [installationId], references: [installationId], onDelete: Cascade)

  @@unique([installationId, date])
  @@index([date])
}

model TelemetryRequest {
  requestId      String       @id @db.Uuid
  installationId String       @db.Uuid
  acceptedAt     DateTime     @default(now()) @db.Timestamptz(3)
  installation   Installation @relation(fields: [installationId], references: [installationId], onDelete: Cascade)

  @@index([acceptedAt])
  @@index([installationId])
}
