# Paddle Configuration
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=test_your_client_token
PADDLE_PRICE_LIFETIME=pri_your_lifetime_price_id

# Telemetry API / Neon Postgres
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Set this in Vercel. Vercel Cron sends it as a Bearer token automatically.
CRON_SECRET=replace_with_a_long_random_value