---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Language } from '@/i18n/ui';
import popupAsset from '@/public/popup.png';
import editTextIcon from '@/assets/edit-text.svg';
import changeImageIcon from '@/assets/change-image.svg';
import removeElementIcon from '@/assets/remove-element.svg';
import screenshotIcon from '@/assets/screenshot.svg';
import premiumAsset from '@/assets/premium.png';
import chromeIcon from '@/assets/chrome.svg';
import edgeIcon from '@/assets/edge.svg';
import step1Video from '@/assets/steps/step1.mp4';
import step2Video from '@/assets/steps/step2.mp4';
import step3Video from '@/assets/steps/step3.mp4';
import step4Video from '@/assets/steps/step4.mp4';
import step5Video from '@/assets/steps/step5.mp4';
import { CHROME_STORE_URL, EDGE_STORE_URL } from '@/lib/store-links';
const { lang } = Astro.props as { lang: Language };
const zh = lang === 'zh';
const store = CHROME_STORE_URL;
const toolIcons = [editTextIcon.src, changeImageIcon.src, removeElementIcon.src, screenshotIcon.src];
const stepVideos = [step1Video, step2Video, step3Video, step4Video, step5Video];
const YOUTUBE_VIDEO_ID = 'otrUoJqhhZY';
const youtubeVideoUrl = YOUTUBE_VIDEO_ID ? `https://youtu.be/${YOUTUBE_VIDEO_ID}` : '';
const c = zh ? {
  title:['随心编辑','任何网页内容'], lead:'无需代码，直接在网页上编辑文字、更改图片、移除元素并截图。所有操作都在本地完成。', add:'立即安装 — 免费使用', learn:'查看使用方法', trust:'无需注册 · 本地处理 · 随时撤回',
  featureTitle:'需要改的，都在手边', features:[['✎','编辑文字','点击网页文字，直接输入新内容。'],['▧','更改图片','上传本地图片，或粘贴图片 URL。'],['⌫','移除元素','点选干扰内容，一次清理干净。'],['⌗','截图','截取当前视窗或整张网页。']],
  how:'使用方法', howTitle:'5 步轻松上手 Edit Page', steps:[['01','打开控制面板，完成设置','设置截图保存方式、界面语言和整张网页截图选项。'],['02','编辑文字','直接在网页文字中放置光标并输入新内容。'],['03','更改图片','上传本地图片，或粘贴图片 URL 替换页面图片。'],['04','移除元素','选择页面中的干扰元素并将其移除。'],['05','整张网页截图','截取完整网页并保存到剪贴板或下载。']],
  privacy:'你的隐私至关重要', privacyTitle:'你的网页内容只属于你。', privacyBody:'Edit Page 直接在浏览器本地处理网页编辑与截图。你的浏览记录、网页内容、替换图片和截图不会被收集或分享。', privacyLocal:'编辑只发生在你选择的当前标签页中；截图只会写入你指定的剪贴板或下载位置。', points:[['不收集网页数据','不会收集密码、浏览记录或网页内容。'],['无行为追踪','不会追踪你访问的网站和编辑操作。'],['不上传内容','替换图片与截图不会上传到我们的服务器。'],['无需账号','安装即可使用，无需创建 Edit Page 账号。']], demoEyebrow:'观看演示', demoTitle:'看看 Edit Page 如何工作', demoBody:'从直接编辑网页内容到保存截图，通过视频快速了解完整使用过程。', demoCta:'在 YouTube 观看',
  plan:'选择适合你的版本', planTitle:'免费开始，需要时再升级', free:['编辑文字不限次数','无限次当前视窗截图','限额 5 次图片导入','限额 5 次移除元素','限额 3 次整张网页截图','到达限额后 12 小时刷新'], premium:['插件所有功能可用','所有功能不限次数','未来更多高级功能更新','不受未来价格影响，永久授权'], freePrice:['0','永久免费'], premPrice:['¥66','一次性付费'], use:'免费使用', buy:'获取 Premium', rec:'推荐', howto:'如何激活 Premium', howtoDesc:'购买后，打开控制面板，在 Premium 卡片中输入激活码即可完成激活。', howtoSteps:[['1','完成购买后，查收邮件中的激活码'],['2','打开 Edit Page 控制面板，进入 Premium 卡片'],['3','输入激活码并激活']], howtoMore:'了解更多',
  faq:'常见问题', faqs:[['Edit Page 会把网页内容上传到服务器吗？','不会。网页编辑在当前浏览器标签页中进行；我们不收集浏览历史、密码或网页内容。'],['编辑会永久修改原网站吗？','不会。修改只存在于当前页面中，刷新网页即可恢复原始内容。'],['“更改图片”支持哪些来源？','支持上传本地图片，也支持粘贴 http 或 https 图片 URL。'],['截图可以保存到哪里？','可在控制面板中设置复制到剪贴板或下载；支持当前视窗与整张网页。'],['如何激活 Premium？','购买后，在控制面板的 Premium 卡片中输入激活码即可。'],['如果我丢失了激活码怎么办？','使用订单邮箱联系我们重新发送新的激活码，同时旧的将会失效。']], final:'你还有想要的功能？', finalCta:'告诉我们'
} : {
  title:['Edit anything','on any webpage'], lead:'Edit text, change images, remove elements and take screenshots right on the page—no code required, everything processed locally.', add:'Install now — It’s free', learn:'See how it works', trust:'No account · Local processing · Undo anytime',
  featureTitle:'Everything you need, right where you need it', features:[['✎','Edit text','Click any text on a webpage and type your update.'],['▧','Change image','Upload a local image or paste an Image URL.'],['⌫','Remove element','Select distractions and clear them away.'],['⌗','Screenshot','Capture the Current viewport or Full page.']],
  how:'How it works', howTitle:'Get started with Edit Page in 5 steps', steps:[['01','Open the Dashboard and finish setup','Choose your screenshot destination, interface language and Full page options.'],['02','Edit text','Place the cursor directly in webpage text and type your update.'],['03','Change image','Upload a local image or paste an Image URL to replace an image.'],['04','Remove element','Select a distracting webpage element and remove it.'],['05','Full page screenshot','Capture the complete webpage to the Clipboard or Download.']],
  privacy:'Your privacy matters', privacyTitle:'Your webpage content stays yours.', privacyBody:'Edit Page processes webpage edits and screenshots locally in your browser. Your browsing history, webpage content, replacement images and screenshots are not collected or shared.', privacyLocal:'Editing only happens in the current tab you choose; screenshots are written only to your selected Clipboard or Download destination.', points:[['No webpage data collection','Passwords, browsing history and webpage content are not collected.'],['No behavior tracking','We do not track the sites you visit or the edits you make.'],['No content uploads','Replacement images and screenshots are not uploaded to our servers.'],['No account required','Install and start using Edit Page without creating an account.']], demoEyebrow:'Watch Demo', demoTitle:'See Edit Page in action', demoBody:'From editing webpage content directly to saving screenshots, see the complete experience in a few minutes.', demoCta:'Watch on YouTube',
  plan:'Choose your version', planTitle:'Start free. Upgrade when you need more.', free:['Unlimited text editing','Unlimited Current viewport screenshots','5 image imports limit','5 element removals limit','3 full-page screenshots limit','Quota resets after 12 hours'], premium:['All extension features available','Unlimited use of all features','Future premium feature updates','Lifetime license, unaffected by future pricing'], freePrice:['0','Free forever'], premPrice:['$10','One-time payment'], use:'Use for free', buy:'Get Premium', rec:'Recommended', howto:'How to activate Premium', howtoDesc:'After purchase, open the Dashboard and enter your License key in the Premium card to activate.', howtoSteps:[['1','Find your License key in the purchase confirmation email'],['2','Open the Edit Page Dashboard and go to the Premium card'],['3','Enter your License key to activate']], howtoMore:'Learn more',
  faq:'Frequently asked questions', faqs:[['Does Edit Page upload webpage content?','No. Editing happens in your current browser tab. We do not collect browsing history, passwords or webpage content.'],['Does editing permanently change the website?','No. Changes only exist in your current page. Refresh the page to restore the original content.'],['What sources does Change image support?','Upload a local image or paste an http or https Image URL.'],['Where are screenshots saved?','Based on Dashboard settings, screenshots go to the Clipboard or Download. Current viewport and Full page are supported.'],['How do I activate Premium?','After purchase, enter your License key in the Premium card in your Dashboard.'],['What if I lose my License key?','Contact us with your order email and we will resend a new License key. The old one will be invalidated.']], final:'Want a feature?', finalCta:'Tell us'
};
---
<BaseLayout lang={lang} title={zh?'Edit Page — 随心编辑任何网页内容':'Edit Page — Edit anything on any webpage'}>
  <section class="hero"><div class="container hero-grid"><div><span class="pill"><i></i>Edit Page 2.0</span><h1>{c.title[0]}<br/><em>{c.title[1]}</em></h1><p class="lead">{c.lead}</p><div class="actions"><a class="button primary" href={store} data-install-link target="_blank" rel="noopener noreferrer">{c.add} ↗</a><a class="button secondary" href="#workflow">{c.learn} ↓</a></div><div class="trust"><span class="browser-links"><a href={CHROME_STORE_URL} target="_blank" rel="noopener noreferrer" aria-label="Install Edit Page for Chrome"><img src={chromeIcon.src} width="20" height="20" alt="Chrome"/></a><a href={EDGE_STORE_URL} target="_blank" rel="noopener noreferrer" aria-label="Install Edit Page for Microsoft Edge"><img src={edgeIcon.src} width="20" height="20" alt="Microsoft Edge"/></a></span><small>✓ {c.trust}</small></div></div><div class="stage"><img class="hero-visual" src="/edit-page-direct-edit-demo.png" alt={zh?'Edit Page 在网页中直接编辑文字的产品演示':'Edit Page direct text editing product demonstration'} width="1280" height="800" fetchpriority="high"/><img class="popup-float" src={popupAsset.src} alt={zh?'Edit Page 2.0 工具选择界面':'Edit Page 2.0 tool picker'} width="796" height="1070" fetchpriority="high"/></div></div></section>
  <section id="features" class="features"><div class="container feature-grid">{c.features.map(([,title,desc],i)=><article><span class={`feature-icon f${i}`}><img src={toolIcons[i]} width="24" height="24" alt=""/></span><div><h2>{title}</h2><p>{desc}</p></div></article>)}</div></section>
  <section id="workflow" class="section"><div class="container"><header class="heading"><span>{c.how}</span><h2>{c.howTitle}</h2></header><div class="workflow-carousel" data-workflow-carousel aria-roledescription={zh?'轮播':'carousel'} aria-label={c.howTitle} tabindex="0"><div class="workflow-viewport"><div class="workflow-track">{c.steps.map(([num,title,desc],i)=><article class="workflow-slide" data-workflow-slide hidden={i!==0} aria-label={`${i+1} / ${c.steps.length}`}>{stepVideos[i] ? <video class="workflow-video" src={stepVideos[i]} width="1920" height="1200" autoplay={i===0} muted loop playsinline preload={i===0?'auto':'metadata'} aria-label={title}></video> : <div class="workflow-placeholder"><span>{num}</span><p>{zh?'演示素材待添加':'Demo media placeholder'}</p></div>}<div class="workflow-caption"><span>{num}</span><div><h3>{title}</h3><p>{desc}</p></div></div></article>)}</div><button class="carousel-arrow carousel-prev" type="button" data-carousel-prev aria-label={zh?'上一个步骤':'Previous step'}><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button><button class="carousel-arrow carousel-next" type="button" data-carousel-next aria-label={zh?'下一个步骤':'Next step'}><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button></div><div class="carousel-footer"><p class="carousel-status" data-carousel-status aria-live="polite">{c.steps[0][1]}</p><div class="carousel-dots" aria-label={zh?'选择演示步骤':'Choose a demo step'}>{c.steps.map(([,title],i)=><button type="button" data-carousel-dot data-index={i} aria-label={`${zh?'查看':'Show'} ${i+1}: ${title}`} aria-current={i===0?'true':undefined}></button>)}</div></div></div></div></section>
  <section class="section privacy"><div class="container"><div class="privacy-card"><span class="eyebrow">{c.privacy}</span><h2>{c.privacyTitle}</h2><p class="privacy-intro">{c.privacyBody}</p><p class="privacy-local">{c.privacyLocal}</p><ul>{c.points.map(([title,desc])=><li><i><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4 4L19 6"/></svg></i><div><h3>{title}</h3><p>{desc}</p></div></li>)}</ul></div></div></section>
  <section id="demo" class="section demo-section"><div class="container demo-grid"><div class="video-shell"><iframe class="video-iframe" data-src={`https://www.youtube-nocookie.com/embed/${YOUTUBE_VIDEO_ID}?rel=0`} title={zh?'Edit Page 演示视频':'Edit Page demo video'} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe><button class="video-facade" type="button" data-youtube-facade data-video-id={YOUTUBE_VIDEO_ID} aria-label={zh?'播放 Edit Page 演示视频':'Play the Edit Page demo video'}><img src="/edit-page-direct-edit-demo.png" width="1280" height="800" alt="" loading="lazy"/><span class="video-play" aria-hidden="true"></span><span class="video-label">{zh?'播放演示':'Play demo'}</span></button><noscript><a href={youtubeVideoUrl} target="_blank" rel="noopener noreferrer">{c.demoCta}</a></noscript></div><div class="demo-copy"><span class="eyebrow">{c.demoEyebrow}</span><h2>{c.demoTitle}</h2><p>{c.demoBody}</p>{youtubeVideoUrl && <a class="button demo-button" href={youtubeVideoUrl} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6z"/></svg>{c.demoCta} ↗</a>}</div></div></section>
  <section id="premium" class="section pricing"><div class="container"><header class="heading"><span>{c.plan}</span><h2>{c.planTitle}</h2></header><div class="prices"><article class="price price-free"><h3>{zh?'免费版':'Free'}</h3><div class="price-row"><span class="amount">{c.freePrice[0]}</span><span class="unit">{c.freePrice[1]}</span></div><ul>{c.free.map(x=><li class="ok"><i><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4 4L19 6"/></svg></i>{x}</li>)}</ul><a class="button secondary" href={store} data-install-link target="_blank" rel="noopener noreferrer">{c.use} →</a></article><article class="price premium-card"><span class="recommended">{c.rec}</span><h3><img src={premiumAsset.src} width="24" height="24" alt="" loading="lazy"/>Premium</h3><div class="price-row"><span class="amount">{c.premPrice[0]}</span><span class="unit">{c.premPrice[1]}</span></div><ul>{c.premium.map(x=><li class="ok"><i><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4 4L19 6"/></svg></i>{x}</li>)}</ul><button class="button primary pricing-buy-button" data-plan="lifetime">{c.buy} →</button></article><article class="price howto-card"><h3><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 2-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>{c.howto}</h3><p class="howto-desc">{c.howtoDesc}</p><ul class="howto-steps">{c.howtoSteps.map(([n,txt])=><li><b>{n}</b><span>{txt}</span></li>)}</ul><a class="howto-link" href="#faq">{c.howtoMore} →</a></article></div></div></section>
  <section id="faq" class="section faq"><div class="container faq-grid"><div><span class="eyebrow">FAQ</span><h2>{c.faq}</h2></div><div>{c.faqs.map(([q,a],i)=><details name="faq" open={i===0}><summary>{q}<span>＋</span></summary><p>{a}</p></details>)}</div></div></section>
  <section class="final"><div class="container"><div><h2>{c.final}</h2></div><a class="button white" href={zh?'/zh/contact':'/contact'}>{c.finalCta} →</a></div></section>
</BaseLayout>
<style>
  .hero{position:relative;overflow:hidden;padding:85px 0 76px;background:radial-gradient(circle at 82% 35%,#dfeaff,transparent 28%),linear-gradient(#fff,#fbfcff)}.hero::before{content:"";position:absolute;inset:0;background-image:linear-gradient(#edf1f8 1px,transparent 1px),linear-gradient(90deg,#edf1f8 1px,transparent 1px);background-size:56px 56px;opacity:.45;mask-image:linear-gradient(#000,transparent 82%)}.hero-grid{position:relative;display:grid;grid-template-columns:.82fr 1.18fr;align-items:center;gap:50px}.pill{display:inline-flex;align-items:center;gap:8px;padding:6px 11px;border:1px solid #dfe6f3;border-radius:999px;background:#fff;color:#525c72;font-size:12px;font-weight:750}.pill i{width:7px;height:7px;border-radius:50%;background:#25be6b}h1{margin:20px 0;font-size:clamp(47px,5vw,72px);line-height:1.05;letter-spacing:-.065em}h1 em{color:var(--blue);font-style:normal}.lead{max-width:530px;color:var(--muted);font-size:17px;line-height:1.85}.actions{display:flex;flex-wrap:wrap;gap:12px;margin:29px 0 17px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 20px;border:1px solid transparent;border-radius:11px;font-weight:780;font-size:14px;text-decoration:none;cursor:pointer;transition:.2s}.button:hover{transform:translateY(-2px)}.primary{color:#fff;background:var(--blue);box-shadow:0 10px 26px #1769ff42}.primary:hover{background:var(--blue-dark)}.secondary{border-color:#d7deeb;background:#fff}.trust{display:flex;align-items:center;gap:10px;color:#758095}.trust small{font-size:12px}.browser-links{display:flex;align-items:center;gap:7px}.browser-links a{display:grid;place-items:center;width:27px;height:27px;border-radius:7px;transition:transform .2s ease,background .2s ease}.browser-links a:hover{transform:translateY(-2px);background:#fff}.browser-links img{width:20px;height:20px}.stage{position:relative;min-height:520px;display:grid;align-items:center}.hero-visual{width:100%;height:auto;border:1px solid #dfe5ef;border-radius:16px;box-shadow:0 28px 70px #1e335b30}.popup-float{position:absolute;z-index:2;right:-78px;bottom:-24px;width:400px;height:auto;border-radius:10px;box-shadow:0 24px 58px #1c2b4942;animation:float 5s ease-in-out infinite}@keyframes float{50%{transform:translateY(-9px)}}
