---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Language } from '@/i18n/ui';
import chromeIcon from '@/assets/chrome.svg';
import edgeIcon from '@/assets/edge.svg';
import dashboardImage from '@/assets/screenshots/dashboard.png';
import editingImage from '@/assets/screenshots/editing.png';
import { CHROME_STORE_URL, EDGE_STORE_URL } from '@/lib/store-links';

const { lang } = Astro.props as { lang: Language };
const zh = lang === 'zh';
const contact = zh ? '/zh/contact' : '/contact';
const installedValue = Astro.url.searchParams.get('installed');
const isInstalled = installedValue === '1' || installedValue === 'true';
const browserValue = Astro.url.searchParams.get('browser')?.toLowerCase();
const browserNames: Record<string, string> = { chrome: 'Chrome', edge: 'Microsoft Edge', firefox: 'Firefox' };
const installedBrowser = browserValue ? browserNames[browserValue] : undefined;
const c = zh ? {
  meta: '安装并设置 Edit Page，完成第一次网页编辑，了解截图选项和常见问题。',
  eyebrow: '开始使用', title: '几分钟上手 Edit Page', intro: '从安装、首次设置到完成第一次编辑。这份指南专注于实际操作，以及遇到问题时该怎么处理。',
  installNow: '安装 Edit Page', onThisPage: '本页目录', startSetup:'开始设置', installedEyebrow:'安装成功', installedTitle:'Edit Page 已安装', installedCopy: installedBrowser ? `已成功安装到 ${installedBrowser}。接下来完成首次设置，然后尝试你的第一次编辑。` : '安装已经完成。接下来完成首次设置，然后尝试你的第一次编辑。',
  nav: [['install','安装与打开'],['setup','首次设置'],['first-edit','第一次编辑'],['rules','操作规则'],['screenshots','截图详解'],['troubleshooting','故障排查']],
  install: { title:'安装与打开', lead:'选择你正在使用的浏览器。安装完成后，建议将 Edit Page 固定到工具栏，之后就能随时打开。', chrome:'安装到 Chrome', edge:'安装到 Edge', steps:['完成浏览器商店中的安装','在扩展菜单中找到 Edit Page，并固定到工具栏','打开一个普通网页，点击 Edit Page 图标'], noteTitle:'找不到插件？', note:'点击浏览器工具栏上的扩展图标，再点击 Edit Page 旁边的固定按钮。浏览器内部页面和扩展商店页面通常不允许插件运行。' },
  setup: { title:'完成首次设置', lead:'第一次使用时先打开控制面板。这里的设置会影响截图保存方式和插件界面。', items:[['界面语言','选择你希望在插件中使用的语言。'],['截图保存位置','选择复制到剪贴板，或直接下载到电脑。'],['整张网页截图','根据使用习惯设置完整页面截图选项。']], tip:'设置完成后会保留在当前浏览器中，不需要每次重新配置。' },
  first: { title:'完成第一次编辑', lead:'先从编辑一段文字开始，这是确认插件正常工作的最快方式。', steps:[['打开工具','点击插件图标，然后选择“编辑文字”。'],['选择文字','点击网页上的任意一段文字，光标会直接出现在内容中。'],['直接输入','像编辑文档一样删除或输入文字，不需要弹窗确认。'],['完成编辑','点击底部的“完成”。刷新网页即可恢复网站原始内容。']], note:'Edit Page 修改的是你当前看到的页面，不会改动网站服务器上的原始数据。' },
  rules: { title:'使用前需要知道', lead:'不同网站的页面结构和安全策略各不相同。了解这些规则，可以更快判断一次操作为什么没有生效，以及还能怎样处理。', cards:[['修改只在当前页面生效','刷新页面、关闭标签页或重新打开网站后，内容会恢复。'],['网页可能重新渲染内容','部分网站会自动刷新某个区域，使刚刚修改的文字或图片恢复。'],['图片 URL 需要可直接访问','使用以 http 或 https 开头的图片地址；某些网站会阻止外部图片加载。'],['部分页面无法使用插件','出于浏览器安全限制，Chrome Web Store、浏览器设置页及其他受保护页面禁止扩展注入代码，因此无法保证每个页面都能编辑。'],['链接文字可以用键盘定位','如果点击目标文字会直接打开链接，可先点击附近一段能够编辑的文字，再用键盘方向键移动光标，直到进入目标链接文字。']], caution:'编辑账号、支付或表单页面时，请勿把页面视觉变化当作真实数据变更。' },
  shots: { title:'选择合适的截图方式', lead:'Edit Page 支持当前视窗与整张网页截图。开始前先在控制面板选择保存到剪贴板还是下载。', viewport:'当前视窗', viewportDesc:'只截取浏览器现在可见的区域。速度快，适合分享局部内容或当前状态。', full:'整张网页', fullDesc:'自动处理页面滚动并生成完整长图，适合保存文章、落地页或完整设计稿。', tips:['进行整页截图时不要滚动页面或切换标签页','先滚动浏览一次，让懒加载图片完成加载','特别长的页面需要更多处理时间','固定导航或悬浮元素可能在长图中重复出现'] },
  trouble: { title:'常见问题排查', lead:'如果操作没有按预期工作，可以先按下面的方法检查。', items:[['点击插件没有反应','确认当前标签页是普通 http 或 https 网页，然后刷新页面再试。浏览器设置页和扩展商店页无法使用。'],['无法选择文字或元素','页面可能位于 iframe 或受保护区域。尝试选择页面主体中的其他内容，确认工具是否正常。'],['替换图片后又恢复了','网站脚本可能重新渲染了该区域。等待页面加载完成后再替换，或暂停会持续刷新的内容。'],['剪贴板中没有截图','检查控制面板中的保存位置，并确认浏览器已授予剪贴板权限；也可以切换为下载。'],['整页截图缺少图片','先手动滚动到页面底部，让懒加载内容出现，再回到顶部开始截图。'],['更新后功能异常','刷新当前网页；如果仍未恢复，关闭并重新打开浏览器，然后确认插件为最新版本。']] },
  finishTitle:'现在，试试你的第一次编辑', finishBody:'打开任意普通网页，点击工具栏中的 Edit Page 图标，然后选择“编辑文字”。', reviewFirstEdit:'回顾编辑步骤', support:'仍然需要帮助？联系我们'
} : {
  meta: 'Install and set up Edit Page, make your first webpage edit, and learn the screenshot options and troubleshooting steps.',
  eyebrow: 'Get Started', title: 'Get up and running in minutes', intro:'Install Edit Page, finish the initial setup, and make your first edit. This guide focuses on practical steps and what to do when something does not work.',
  installNow:'Install Edit Page', onThisPage:'On this page', startSetup:'Start setup', installedEyebrow:'Installation complete', installedTitle:'Edit Page is installed', installedCopy: installedBrowser ? `Edit Page was successfully installed in ${installedBrowser}. Finish the initial setup, then make your first edit.` : 'Installation is complete. Finish the initial setup, then make your first edit.',
  nav: [['install','Install and open'],['setup','Initial setup'],['first-edit','Your first edit'],['rules','Editing rules'],['screenshots','Screenshots'],['troubleshooting','Troubleshooting']],
  install: { title:'Install and open', lead:'Choose your browser. After installation, pin Edit Page to the toolbar so it is always easy to open.', chrome:'Install for Chrome', edge:'Install for Edge', steps:['Complete the installation in your browser store','Find Edit Page in the extensions menu and pin it to the toolbar','Open a regular webpage and select the Edit Page icon'], noteTitle:'Cannot find the extension?', note:'Open the extensions menu in your browser, then select the pin next to Edit Page. Browser internal pages and extension store pages normally prevent extensions from running.' },
  setup: { title:'Finish the initial setup', lead:'Open the Dashboard before your first use. These preferences control where screenshots go and how the extension behaves.', items:[['Interface language','Choose the language you want to use inside the extension.'],['Screenshot destination','Copy screenshots to the Clipboard or download them to your computer.'],['Full page capture','Configure the full-page screenshot options for the way you work.']], tip:'Your settings are saved in the current browser, so you do not need to configure them every time.' },
  first: { title:'Make your first edit', lead:'Start by changing one piece of text. It is the quickest way to confirm that everything is working.', steps:[['Open the tool','Select the extension icon, then choose Edit text.'],['Select some text','Click any text on the webpage. The cursor appears directly in the content.'],['Type directly','Delete or enter text just like a document. There is no confirmation dialog.'],['Finish editing','Select Done in the bottom bar. Refresh the webpage to restore the original content.']], note:'Edit Page changes only the page currently shown in your browser. It never changes the original data on the website server.' },
  rules: { title:'What to know before editing', lead:'Websites use different page structures and security policies. These notes explain why an edit may not work—and what you can try next.', cards:[['Changes are local to the current page','Refreshing, closing the tab, or reopening the website restores the original content.'],['Websites may re-render content','Some sites automatically refresh parts of a page, which can restore edited text or images.'],['Image URLs must be directly accessible','Use an image address beginning with http or https. Some websites block images from external sources.'],['Some pages cannot run extensions','Browser security prevents code injection on protected pages such as the Chrome Web Store and browser settings, so editing cannot be guaranteed everywhere.'],['Use the keyboard to reach linked text','If selecting the target text immediately opens a link, place the cursor in nearby editable text first, then use the arrow keys to move it into the linked text.']], caution:'On account, payment, or form pages, never treat a visual edit as a change to the underlying data.' },
  shots: { title:'Choose the right screenshot mode', lead:'Edit Page supports Current viewport and Full page captures. First choose Clipboard or Download in the Dashboard.', viewport:'Current viewport', viewportDesc:'Captures only the area currently visible in the browser. It is fast and useful for sharing a specific section or state.', full:'Full page', fullDesc:'Processes the page while scrolling and creates one complete image—useful for articles, landing pages, and design references.', tips:['Do not scroll or switch tabs during a full-page capture','Scroll through the page once so lazy-loaded images can appear','Very long pages require more processing time','Sticky navigation and floating elements may repeat in a long capture'] },
  trouble: { title:'Troubleshooting', lead:'If something does not work as expected, start with these checks.', items:[['Nothing happens when I select the extension','Make sure the current tab is a regular http or https webpage, then refresh and try again. Browser settings and extension stores are unsupported.'],['I cannot select text or an element','The content may be inside an iframe or protected area. Try content in the main page to confirm that the tool works.'],['A replaced image changes back','The website may be re-rendering that section. Wait for the page to finish loading, then replace it again.'],['The screenshot is not in my clipboard','Check the destination in the Dashboard and make sure Clipboard permission is allowed, or switch to Download.'],['Images are missing from a full-page capture','Scroll to the bottom first so lazy-loaded content appears, then return to the top and start the capture.'],['Features behave unexpectedly after an update','Refresh the current webpage. If the issue remains, restart the browser and confirm that the extension is up to date.']] },
  finishTitle:'Now, make your first edit', finishBody:'Open any regular webpage, select the Edit Page icon in your toolbar, then choose Edit text.', reviewFirstEdit:'Review the editing steps', support:'Still need help? Contact us'
};
---

<BaseLayout lang={lang} title={`${c.eyebrow} | Edit Page`} description={c.meta}>
  {isInstalled && <section class="installed-banner"><div class="container"><div><span>{c.installedEyebrow}</span><h2>{c.installedTitle}</h2><p>{c.installedCopy}</p></div><a href="#setup">{c.startSetup} ↓</a></div></section>}
  <section class="guide-hero"><div class="container"><span>{c.eyebrow}</span><h1>{c.title}</h1><p>{c.intro}</p>{isInstalled ? <a class="primary-link" href="#setup">{c.startSetup} ↓</a> : <a class="primary-link" href={CHROME_STORE_URL} data-install-link target="_blank" rel="noopener noreferrer">{c.installNow} ↗</a>}</div></section>
  <div class="container mobile-toc"><details><summary>{c.onThisPage}<span>＋</span></summary><nav aria-label={c.onThisPage}>{c.nav.map(([id,label])=><a href={`#${id}`}>{label}</a>)}</nav></details></div>
  <div class="container guide-layout">
    <aside><nav aria-label={c.onThisPage}><strong>{c.onThisPage}</strong>{c.nav.map(([id,label],i)=><a href={`#${id}`} class={i===0?'active':undefined}><span>{String(i+1).padStart(2,'0')}</span>{label}</a>)}</nav></aside>
    <article class="guide-content">
      <section id="install"><header><span>01</span><div><h2>{c.install.title}</h2><p>{c.install.lead}</p></div></header><div class="store-grid"><a href={CHROME_STORE_URL} target="_blank" rel="noopener noreferrer"><img src={chromeIcon.src} width="32" height="32" alt="Chrome"/><span>{c.install.chrome}</span><b>↗</b></a><a href={EDGE_STORE_URL} target="_blank" rel="noopener noreferrer"><img src={edgeIcon.src} width="32" height="32" alt="Microsoft Edge"/><span>{c.install.edge}</span><b>↗</b></a></div><ol class="numbered">{c.install.steps.map((item,i)=><li><b>{i+1}</b><span>{item}</span></li>)}</ol><div class="callout info"><b>{c.install.noteTitle}</b><p>{c.install.note}</p></div></section>
      <section id="setup"><header><span>02</span><div><h2>{c.setup.title}</h2><p>{c.setup.lead}</p></div></header><figure class="media dashboard"><img src={dashboardImage.src} width="2116" height="1846" alt={c.setup.title} loading="lazy"/></figure><div class="setting-grid">{c.setup.items.map(([title,body])=><div><i>✓</i><h3>{title}</h3><p>{body}</p></div>)}</div><div class="callout tip"><p>{c.setup.tip}</p></div></section>
      <section id="first-edit"><header><span>03</span><div><h2>{c.first.title}</h2><p>{c.first.lead}</p></div></header><figure class="media"><img src={editingImage.src} width="2618" height="1436" alt={c.first.title} loading="lazy"/></figure><ol class="edit-steps">{c.first.steps.map(([title,body],i)=><li><b>{i+1}</b><div><h3>{title}</h3><p>{body}</p></div></li>)}</ol><div class="callout privacy-note"><p>{c.first.note}</p></div></section>
      <section id="rules"><header><span>04</span><div><h2>{c.rules.title}</h2><p>{c.rules.lead}</p></div></header><div class="rule-grid">{c.rules.cards.map(([title,body])=><article><div class="rule-icon">✓</div><h3>{title}</h3><p>{body}</p></article>)}</div><div class="callout warning"><p>{c.rules.caution}</p></div></section>
      <section id="screenshots"><header><span>05</span><div><h2>{c.shots.title}</h2><p>{c.shots.lead}</p></div></header><div class="capture-grid"><article><span class="capture-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 9h10v6H7z"/></svg></span><h3>{c.shots.viewport}</h3><p>{c.shots.viewportDesc}</p></article><article><span class="capture-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 6h6M9 10h6M9 14h6"/></svg></span><h3>{c.shots.full}</h3><p>{c.shots.fullDesc}</p></article></div><ul class="check-list">{c.shots.tips.map(item=><li><i>✓</i>{item}</li>)}</ul></section>
      <section id="troubleshooting"><header><span>06</span><div><h2>{c.trouble.title}</h2><p>{c.trouble.lead}</p></div></header><div class="troubleshooting">{c.trouble.items.map(([q,a])=><details><summary>{q}<span>＋</span></summary><p>{a}</p></details>)}</div></section>
    </article>
  </div>
  <section class="guide-cta"><div class="container"><div><h2>{c.finishTitle}</h2><p>{c.finishBody}</p></div><div><a class="primary-link white" href="#first-edit">{c.reviewFirstEdit} ↑</a><a class="support-link" href={contact}>{c.support} →</a></div></div></section>
</BaseLayout>

<style>
  .installed-banner{padding:26px 0;background:linear-gradient(120deg,#155fee,#5a38e9);color:#fff}.installed-banner>.container{display:flex;align-items:center;justify-content:space-between;gap:30px}.installed-banner span{color:#dce7ff;font-size:11px;font-weight:850;letter-spacing:.15em;text-transform:uppercase}.installed-banner h2{margin:3px 0 2px;font-size:24px;letter-spacing:-.025em}.installed-banner p{max-width:730px;margin:0;color:#e4ebff;font-size:13px}.installed-banner a{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 18px;border-radius:999px;background:#fff;color:var(--blue);font-size:13px;font-weight:780;text-decoration:none;white-space:nowrap}
  .guide-hero{padding:82px 0 76px;text-align:center;background:radial-gradient(circle at 50% 0,#e4edff,transparent 48%),linear-gradient(#fff,#f8faff);border-bottom:1px solid var(--line)}.guide-hero .container{max-width:820px}.guide-hero span{color:var(--blue);font-size:14px;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.guide-hero h1{margin:14px 0 18px;font-size:clamp(42px,6vw,66px);line-height:1.05;letter-spacing:-.055em}.guide-hero p{max-width:690px;margin:0 auto;color:var(--muted);font-size:17px;line-height:1.8}.primary-link{display:inline-flex;align-items:center;justify-content:center;min-height:48px;margin-top:28px;padding:0 21px;border-radius:11px;color:#fff;background:var(--blue);box-shadow:0 10px 26px #1769ff38;font-size:14px;font-weight:780;text-decoration:none}.primary-link:hover{background:var(--blue-dark)}
  .guide-layout{display:grid;grid-template-columns:220px minmax(0,760px);justify-content:center;gap:74px;padding-top:64px;padding-bottom:90px}.guide-layout aside nav{position:sticky;top:105px;display:flex;flex-direction:column}.guide-layout aside strong{margin-bottom:13px;color:#939bad;font-size:11px;letter-spacing:.12em;text-transform:uppercase}.guide-layout aside a{display:flex;align-items:center;gap:11px;padding:8px 10px;border-left:2px solid #e3e8f1;color:#687086;font-size:13px;text-decoration:none}.guide-layout aside a span{font-size:10px;font-weight:800}.guide-layout aside a:hover,.guide-layout aside a.active{border-color:var(--blue);color:var(--blue);background:#f3f7ff}.mobile-toc{display:none}.guide-content>section{padding:4px 0 72px;scroll-margin-top:95px}.guide-content>section+section{padding-top:64px;border-top:1px solid var(--line)}.guide-content section>header{display:flex;align-items:flex-start;gap:18px;margin-bottom:28px}.guide-content section>header>span{display:grid;place-items:center;flex:0 0 42px;height:42px;border-radius:13px;background:#e8f0ff;color:var(--blue);font-size:12px;font-weight:850}.guide-content h2{margin:0;font-size:clamp(28px,4vw,38px);line-height:1.15;letter-spacing:-.04em}.guide-content section>header p{margin:9px 0 0;color:var(--muted);font-size:15px;line-height:1.75}.store-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.store-grid a{display:flex;align-items:center;gap:13px;padding:18px;border:1px solid #dce3ef;border-radius:15px;background:#fff;box-shadow:0 8px 24px #2536580c;text-decoration:none}.store-grid a:hover{border-color:#a9c4fb;background:#f8faff}.store-grid img{width:32px;height:32px}.store-grid span{font-size:14px;font-weight:750}.store-grid b{margin-left:auto;color:var(--blue)}
  .numbered{display:grid;gap:12px;margin:28px 0;padding:0;list-style:none}.numbered li{display:flex;align-items:center;gap:13px;color:#3f485c;font-size:14px}.numbered b,.edit-steps>li>b{display:grid;place-items:center;flex:0 0 28px;height:28px;border-radius:50%;background:var(--blue);color:#fff;font-size:11px}.callout{margin-top:25px;padding:18px 20px;border:1px solid #d8e4fb;border-radius:14px;background:#f3f7ff;color:#40506d}.callout b{font-size:13px}.callout p{margin:4px 0 0;font-size:13px;line-height:1.7}.callout.tip p,.callout.privacy-note p,.callout.warning p{margin:0}.callout.tip{border-color:#d9ede4;background:#f3fbf7;color:#32634c}.callout.privacy-note{border-color:#dcd7fb;background:#f7f5ff;color:#504b75}.callout.warning{border-color:#f1dfb9;background:#fffbf0;color:#705829}
  .media{overflow:hidden;margin:0 0 28px;border:1px solid #dce2ed;border-radius:18px;background:#f5f7fb;box-shadow:0 15px 42px #23385f13}.media img{width:100%;height:auto}.media.dashboard{max-width:650px}.setting-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.setting-grid>div{padding:18px;border:1px solid var(--line);border-radius:14px}.setting-grid i{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:#e4edff;color:var(--blue);font-size:11px;font-style:normal;font-weight:850}.setting-grid h3,.rule-grid h3,.capture-grid h3,.edit-steps h3{margin:13px 0 5px;font-size:14px}.setting-grid p,.rule-grid p,.capture-grid p,.edit-steps p{margin:0;color:var(--muted);font-size:12.5px;line-height:1.65}.edit-steps{display:grid;grid-template-columns:repeat(2,1fr);gap:22px;margin:0;padding:0;list-style:none}.edit-steps li{display:flex;align-items:flex-start;gap:13px}.edit-steps h3{margin:2px 0 4px}.rule-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.rule-grid article{padding:20px;border:1px solid var(--line);border-radius:16px;background:#fbfcff}.rule-icon{display:grid;place-items:center;width:30px;height:30px;border-radius:10px;background:#e8f0ff;color:var(--blue);font-weight:850}.capture-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.capture-grid article{padding:24px;border:1px solid var(--line);border-radius:17px;background:linear-gradient(145deg,#f7faff,#fff)}.capture-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:12px;background:#e7efff;color:var(--blue)}.capture-grid h3{font-size:16px}.check-list{display:grid;grid-template-columns:repeat(2,1fr);gap:10px 20px;margin:26px 0 0;padding:0;list-style:none}.check-list li{display:flex;align-items:flex-start;gap:9px;color:#4b556a;font-size:13px}.check-list i{color:var(--blue);font-style:normal;font-weight:850}.troubleshooting details{border-bottom:1px solid var(--line)}.troubleshooting summary{display:flex;justify-content:space-between;gap:20px;padding:18px 0;cursor:pointer;list-style:none;font-size:14px;font-weight:750}.troubleshooting summary::-webkit-details-marker{display:none}.troubleshooting details[open] summary span{transform:rotate(45deg)}.troubleshooting summary span{color:var(--blue);transition:transform .2s}.troubleshooting details p{margin:-4px 42px 20px 0;color:var(--muted);font-size:13px;line-height:1.75}
