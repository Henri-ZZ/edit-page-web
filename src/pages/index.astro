---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translations } from '@/i18n/ui';

const lang = 'en';
const t = translations[lang];
---

<BaseLayout lang={lang} title="Edit Page - Edit any webpage">
  <section class="hero">
    <div class="container">
      <h1>{t.hero.title}</h1>
      <p class="subtitle">{t.hero.subtitle}</p>
      <p class="description">{t.hero.description}</p>
      <a href="https://chrome.google.com/webstore" class="cta-button" target="_blank">{t.hero.cta}</a>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <h2>{t.features.title}</h2>
      <div class="feature-grid">
        {t.features.list.map((feature) => (
          <div class="feature-card">
            <h3>{feature.title}</h3>
            <p>{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pricing">
    <div class="container">
      <h2>{t.pricing.title}</h2>
      <div class="pricing-grid">
        <div class="pricing-card">
          <h3>{t.pricing.list[1].title}</h3>
          <div class="price">{t.pricing.list[1].price}</div>
          <p>{t.pricing.list[1].desc}</p>
          <button class="pricing-buy-button" data-plan="monthly">
            Buy Now
          </button>
        </div>
        <div class="pricing-card featured">
          <h3>{t.pricing.list[0].title}</h3>
          <div class="price">{t.pricing.list[0].price}</div>
          <p>{t.pricing.list[0].desc}</p>
          <button class="pricing-buy-button" data-plan="lifetime">
            Buy Now
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="browsers">
    <div class="container">
      <h2>{t.browsers.title}</h2>
      <p>{t.browsers.desc}</p>
    </div>
  </section>

  <section class="contact">
    <div class="container">
      <h2>{t.contact.title}</h2>
      <p>{t.contact.email}</p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Open Paddle checkout
  function openCheckout(productId) {
    if (!productId) {
      alert('Product ID not configured. Please check back later.');
      return;
    }

    if (typeof Paddle === 'undefined') {
      alert('Paddle not initialized. Please refresh the page.');
      return;
    }

    Paddle.Checkout.open({
      items: [{ priceId: productId, quantity: 1 }]
    });
  }

  // Get product ID from config based on plan
  function getProductId(plan) {
    const cfg = window.EDIT_PAGE_PADDLE_CONFIG;
    if (!cfg || !cfg.priceIds) return null;
    return cfg.priceIds[plan];
  }

  // Add click handlers to buy buttons
  document.addEventListener('DOMContentLoaded', function() {
    const buttons = document.querySelectorAll('.pricing-buy-button[data-plan]');
    buttons.forEach(button => {
      button.addEventListener('click', function() {
        const plan = this.getAttribute('data-plan');
        const productId = getProductId(plan);
        openCheckout(productId);
      });
    });
  });

  // Auto-detect browser language and redirect if needed
  (function() {
    // Check if user has already been redirected in this session
    if (sessionStorage.getItem('langRedirected')) {
      return;
    }

    // Get browser language
    const browserLang = navigator.language || navigator.userLanguage;

    // If browser language is Chinese, redirect to Chinese version
    if (browserLang && browserLang.startsWith('zh')) {
      sessionStorage.setItem('langRedirected', 'true');
      window.location.href = '/zh/';
    }
  })();
</script>
