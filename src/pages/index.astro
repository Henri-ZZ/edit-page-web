---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translations } from '@/i18n/ui';

const lang = 'en';
const t = translations[lang];

// Paddle product IDs - leave empty for now
const PADDLE_LIFETIME_ID = '';
const PADDLE_MONTHLY_ID = '';
---

<BaseLayout lang={lang} title="Edit Page - Edit any webpage">
  <section class="hero">
    <div class="container">
      <h1>{t.hero.title}</h1>
      <p class="subtitle">{t.hero.subtitle}</p>
      <p class="description">{t.hero.description}</p>
      <a href="https://chrome.google.com/webstore" class="cta-button" target="_blank">{t.hero.cta}</a>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <h2>{t.features.title}</h2>
      <div class="feature-grid">
        {t.features.list.map((feature) => (
          <div class="feature-card">
            <h3>{feature.title}</h3>
            <p>{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pricing">
    <div class="container">
      <h2>{t.pricing.title}</h2>
      <div class="pricing-grid">
        <div class="pricing-card">
          <h3>{t.pricing.list[1].title}</h3>
          <div class="price">{t.pricing.list[1].price}</div>
          <p>{t.pricing.list[1].desc}</p>
          <a href={PADDLE_MONTHLY_ID ? `https://checkout.paddle.com/checkout/${PADDLE_MONTHLY_ID}` : '#'} class="pricing-buy-button">
            Buy Now
          </a>
        </div>
        <div class="pricing-card featured">
          <h3>{t.pricing.list[0].title}</h3>
          <div class="price">{t.pricing.list[0].price}</div>
          <p>{t.pricing.list[0].desc}</p>
          <a href={PADDLE_LIFETIME_ID ? `https://checkout.paddle.com/checkout/${PADDLE_LIFETIME_ID}` : '#'} class="pricing-buy-button">
            Buy Now
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="browsers">
    <div class="container">
      <h2>{t.browsers.title}</h2>
      <p>{t.browsers.desc}</p>
    </div>
  </section>

  <section class="contact">
    <div class="container">
      <h2>{t.contact.title}</h2>
      <p>{t.contact.email}</p>
    </div>
  </section>
</BaseLayout>

<script>
  // Auto-detect browser language and redirect if needed
  (function() {
    // Check if user has already been redirected in this session
    if (sessionStorage.getItem('langRedirected')) {
      return;
    }

    // Get browser language
    const browserLang = navigator.language || (navigator as any).userLanguage;

    // If browser language is Chinese, redirect to Chinese version
    if (browserLang && browserLang.startsWith('zh')) {
      sessionStorage.setItem('langRedirected', 'true');
      window.location.href = '/zh/';
    }
  })();
</script>
