---
import productIcon from '@/assets/edit-page-icon.svg';
import { CHROME_STORE_URL } from '@/lib/store-links';
import { translations } from '@/i18n/ui';

const lang = 'zh';
const t = translations[lang];
const g = t.goodbye;
const TALLY_FORM = 'https://tally.so/embed/RG9o1K?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1';
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={g.meta} />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href={productIcon.src} />
  <title>{g.title} | Edit Page</title>
  <script is:inline>
    (function () {
      var KEY = 'edit-page-lang';
      var saved = null;
      try { saved = localStorage.getItem(KEY); } catch (e) {}
      var preferred;
      if (saved === 'en' || saved === 'zh') { preferred = saved; }
      else {
        var nav = (navigator.language || navigator.userLanguage || '').toLowerCase();
        preferred = nav.indexOf('zh') === 0 ? 'zh' : 'en';
      }
      function init() {
        var sel = document.getElementById('locale-switcher');
        if (!sel) return;
        sel.value = preferred;
        sel.addEventListener('change', function () {
          var next = sel.value;
          try { localStorage.setItem(KEY, next); } catch (e) {}
          location.assign(next === 'zh' ? '/zh/goodbye' : '/goodbye');
        });
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
      else init();
    })();
  </script>
  <style is:global>
    :root {
      --ink: #0b1224; --muted: #687086; --line: #e6eaf2;
      --blue: #1769ff; --blue-dark: #0754e8;
      font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: var(--ink); font-synthesis: none;
    }
    * { box-sizing: border-box; }
    body { margin: 0; min-width: 320px; line-height: 1.6; }
    a { color: inherit; }
    .goodbye { position: relative; min-height: 100vh; overflow: hidden; background: #fbfcff; }
    .glow {
      position: absolute; inset: 0; pointer-events: none;
      background:
        radial-gradient(circle at 14% 12%, rgba(23, 105, 255, .10), transparent 34%),
        radial-gradient(circle at 88% 8%, rgba(23, 105, 255, .12), transparent 36%),
        radial-gradient(circle at 50% 100%, rgba(23, 105, 255, .07), transparent 42%);
    }
    .grid-bg {
      position: absolute; inset: 0; pointer-events: none; opacity: .45;
      background-image:
        linear-gradient(#edf1f8 1px, transparent 1px),
        linear-gradient(90deg, #edf1f8 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: linear-gradient(#000, transparent 82%);
    }
    .page { position: relative; width: min(1180px, calc(100% - 40px)); margin-inline: auto; padding: 20px 0 48px; }
    .mini-header { display: flex; align-items: center; justify-content: space-between; }
    .brand { display: inline-flex; align-items: center; gap: 11px; font-size: 17px; font-weight: 800; letter-spacing: -.03em; text-decoration: none; }
    .brand img { width: 38px; height: 38px; object-fit: contain; }
    .lang-switch { position: relative; display: flex; align-items: center; }
    .lang-switch svg { position: absolute; right: 11px; top: 50%; translate: 0 -50%; pointer-events: none; color: #8a93a6; }
    .locale-select {
      appearance: none; -webkit-appearance: none; height: 36px; padding: 0 30px 0 14px;
      border: 1px solid #d7deeb; border-radius: 999px; background: #fff;
      color: #3d4558; font-size: 13px; font-weight: 700; font-family: inherit; cursor: pointer;
      transition: border-color .2s;
    }
    .locale-select:hover { border-color: var(--blue); }
    .locale-select:focus { outline: 3px solid rgba(23, 105, 255, .35); outline-offset: 2px; }
    .content { max-width: 820px; margin: 0 auto; padding: 56px 0 16px; }
    .badge {
      display: inline-flex; align-items: center; padding: 6px 13px;
      border: 1px solid #cfe0ff; border-radius: 999px; background: #eaf2ff;
      color: var(--blue); font-size: 12px; font-weight: 800;
      letter-spacing: .18em; text-transform: uppercase;
    }
    .content h1 { margin: 20px 0 0; font-size: clamp(36px, 5.4vw, 54px); line-height: 1.08; letter-spacing: -.05em; }
    .lead { margin: 18px 0 0; max-width: 640px; color: var(--muted); font-size: 17px; line-height: 1.8; }
    .panel {
      margin-top: 40px; overflow: hidden;
      border: 1px solid var(--line); border-radius: 28px;
      background: rgba(255, 255, 255, .92);
      box-shadow: 0 30px 70px #1e335b1f;
      backdrop-filter: blur(18px);
    }
    .panel-head { display: flex; align-items: flex-start; gap: 16px; padding: 28px 32px; border-bottom: 1px solid var(--line); }
    .icon-chip {
      display: grid; place-items: center; width: 44px; height: 44px; margin-top: 2px;
      border-radius: 13px; background: #eaf2ff; color: var(--blue);
    }
    .panel-head h2 { margin: 0; font-size: 20px; font-weight: 750; line-height: 1.5; letter-spacing: -.02em; }
    .panel-head p { margin: 8px 0 0; color: var(--muted); font-size: 14px; line-height: 1.7; }
    .panel-body { padding: 12px; }
    .panel-body iframe { display: block; width: 100%; min-height: 620px; height: 680px; border: 0; border-radius: 18px; background: #fff; }
    .footnote { margin: 32px 0 0; text-align: center; color: var(--muted); font-size: 14px; }
    .footnote a { color: var(--blue); font-weight: 650; text-decoration: none; }
    .footnote a:hover { color: var(--blue-dark); text-decoration: underline; }
    @media (max-width: 640px) {
      .content { padding-top: 40px; }
      .panel-head { padding: 22px 20px; }
      .panel-head h2 { font-size: 17px; }
      .panel-body iframe { min-height: 620px; height: 620px; }
    }
  </style>
</head>
<body>
  <main class="goodbye">
    <div class="glow" aria-hidden="true"></div>
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="page">
      <header class="mini-header">
        <a class="brand" href="/zh/"><img src={productIcon.src} width="38" height="38" alt="" /><span>Edit Page</span></a>
        <div class="lang-switch">
          <select id="locale-switcher" class="locale-select" aria-label="切换语言">
            <option value="en">English</option>
            <option value="zh">中文</option>
          </select>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </div>
      </header>
      <section class="content">
        <span class="badge">{g.badge}</span>
        <h1>{g.title}</h1>
        <p class="lead">{g.intro}</p>
        <div class="panel">
          <div class="panel-head">
            <div class="icon-chip">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/><path d="M8 9h8M8 13h5"/></svg>
            </div>
            <div>
              <h2>{g.question}</h2>
              <p>{g.questionDesc}</p>
            </div>
          </div>
          <div class="panel-body">
            <iframe src={TALLY_FORM} title={g.formTitle} loading="eager" />
          </div>
        </div>
        <p class="footnote">{g.changedMind} <a href={CHROME_STORE_URL} target="_blank" rel="noopener noreferrer">{g.reinstall}</a></p>
      </section>
    </div>
  </main>
</body>
</html>
