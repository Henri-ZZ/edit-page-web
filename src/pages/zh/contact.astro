---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { translations } from '@/i18n/ui';

const lang = 'zh';
const t = translations[lang];
const c = t.contactPage;
const TALLY_FORM = 'https://tally.so/embed/RG9o6Q';
---

<BaseLayout lang={lang} title={`${c.title} | Edit Page`} description={c.meta}>
  <style>
    .contact-page { padding: 76px 0 96px; }
    .contact-head { text-align: center; max-width: 720px; margin: 0 auto; }
    .badge {
      display: inline-flex; align-items: center; padding: 6px 13px;
      border: 1px solid #cfe0ff; border-radius: 999px; background: #eaf2ff;
      color: var(--blue); font-size: 12px; font-weight: 800;
      letter-spacing: .14em; text-transform: uppercase;
    }
    .contact-head h1 { margin: 22px 0 0; font-size: clamp(34px, 4.6vw, 46px); line-height: 1.12; letter-spacing: -.045em; }
    .contact-head p { margin: 16px auto 0; max-width: 620px; color: var(--muted); font-size: 17px; line-height: 1.85; }
    .contact-grid { display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 52px; }
    @media (min-width: 900px) { .contact-grid { grid-template-columns: 320px 1fr; gap: 28px; align-items: start; } }
    .info-cards { display: flex; flex-direction: column; gap: 20px; }
    .card { padding: 24px; border: 1px solid var(--line); border-radius: 18px; background: var(--surface); }
    .icon-chip {
      display: grid; place-items: center; width: 42px; height: 42px; margin-bottom: 16px;
      border-radius: 12px; background: #eaf2ff; color: var(--blue);
    }
    .card h3 { margin: 0 0 6px; font-size: 16px; font-weight: 780; letter-spacing: -.01em; }
    .card p { margin: 0; color: var(--muted); font-size: 13.5px; line-height: 1.7; }
    .card a { display: inline-block; margin-top: 10px; color: var(--blue); font-size: 13.5px; font-weight: 700; word-break: break-all; text-decoration: none; }
    .card a:hover { color: var(--blue-dark); text-decoration: underline; }
    .form-card { padding: 14px; border: 1px solid var(--line); border-radius: 24px; background: #fff; box-shadow: 0 14px 40px #1e335b14; }
    .form-card iframe { display: block; width: 100%; height: 680px; border: 0; border-radius: 14px; }
    @media (max-width: 900px) { .form-card iframe { height: 720px; } }
  </style>

  <div class="container">
    <section class="contact-page">
      <div class="contact-head">
        <span class="badge">{c.badge}</span>
        <h1>{c.title}</h1>
        <p>{c.intro}</p>
      </div>
      <div class="contact-grid">
        <div class="info-cards">
          <div class="card">
            <div class="icon-chip">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <h3>{c.emailTitle}</h3>
            <p>{c.emailDesc}</p>
            <a href="mailto:henri@henriz.dev">henri@henriz.dev</a>
          </div>
          <div class="card">
            <div class="icon-chip">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <h3>{c.responseTitle}</h3>
            <p>{c.responseDesc}</p>
          </div>
        </div>
        <div class="form-card">
          <iframe src={TALLY_FORM} title={c.formTitle} loading="lazy" />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
