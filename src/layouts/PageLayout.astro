---
import BaseLayout from './BaseLayout.astro';
import { translations, type Language } from '@/i18n/ui';

interface Props {
  lang?: Language;
  title: string;
  content: {
    title: string;
    lastUpdated: string;
    sections: Array<{ title: string; content: string | string[] }>;
    compliance?: string;
  };
}

const { lang = 'en', title, content } = Astro.props;
---

<BaseLayout lang={lang} title={title}>
  <style>
    .page-content {
      padding: 60px 0;
      max-width: 800px;
      margin: 0 auto;
    }
    .page-content h1 {
      font-size: 36px;
      margin-bottom: 10px;
    }
    .last-updated {
      color: #666;
      margin-bottom: 40px;
      font-size: 14px;
    }
    .page-content section {
      margin-bottom: 30px;
    }
    .page-content h2 {
      font-size: 20px;
      margin-bottom: 10px;
      color: #333;
    }
    .page-content p {
      color: #555;
      line-height: 1.8;
    }
    .page-content section p {
      margin: 0 0 12px;
    }
    .page-content section p:last-child {
      margin-bottom: 0;
    }
    .compliance {
      margin: 8px 0 0;
      padding-top: 22px;
      border-top: 1px solid #e2e6ed;
      font-size: 14px;
    }
  </style>
  <div class="container">
    <div class="page-content">
      <h1>{content.title}</h1>
      <p class="last-updated">{content.lastUpdated}</p>
      {content.sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          {(Array.isArray(section.content) ? section.content : [section.content]).map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))}
      {content.compliance && <p class="compliance">{content.compliance}</p>}
    </div>
  </div>
</BaseLayout>
